---
interface Impact {
  headline: string;
  description: string;
  link?: string | null;
}

interface ClientQuote {
  quote: string;
  name: string;
}

interface Project {
  title: string;
  shortName?: string | null;
  client: string | null;
  clientType: string;
  description: string;
  impact: Impact[];
  clientQuote?: ClientQuote | null;
  categories: string[];
  capabilities: string[];
  role: string;
  primeContractor?: string | null;
  isJointVenture: boolean;
  featured: boolean;
  href?: string | null;
  projectStatus: string;
  portfolio?: boolean;
  footprint?: boolean;
  projectStartDate: string;
  projectEndDate?: string | null;
}

interface Props {
  projects: Project[];
  eyebrow?: string;
  heading?: string;
}

const { projects, eyebrow = "Portfolio", heading = "All engagements" } = Astro.props;

const allCategories = [...new Set(projects.flatMap((p) => p.categories))].sort();
const allCapabilities = [...new Set(projects.flatMap((p) => p.capabilities))].sort();
const allClientTypes = [...new Set(projects.map((p) => p.clientType))].sort();
const formatProjectDates = (project: Project) => `${project.projectStartDate}–${project.projectEndDate ?? 'Present'}`;
const slugifyProject = (project: Project) =>
  (project.shortName || project.title)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const showFilters = projects.length > 1;
---

<section id="portfolio" class="portfolio-section surface-subtle py-14 md:py-20">
  <div class="page-shell">
    <div class="mb-10 sm:mb-14">
      <div class="mb-4 text-sm font-semibold uppercase text-[var(--color-brand-accent)]">
        {eyebrow}
      </div>
      <h2 class="section-heading max-w-[30rem]">
        {heading}
      </h2>
    </div>

    {showFilters && (
      <div class="mb-8">
        <div class="mb-2 flex items-center gap-3">
          <div class="text-[0.88rem] font-semibold text-[var(--color-brand-ink)]">Filter</div>
          <a href="#" id="filter-clear" class="hidden text-[0.82rem] font-medium text-[var(--color-brand-accent)] underline underline-offset-2 transition-colors hover:text-[var(--color-brand-ink)]">
            Clear
          </a>
        </div>
        <div class="flex items-end gap-3 md:max-w-[50%]">
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <label for="filter-category" class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-brand-soft)]">Category</label>
            <div class="relative">
              <select id="filter-category" class="w-full appearance-none rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-white px-3 py-1.5 pr-7 text-[0.82rem] font-medium text-[var(--color-brand-ink)] transition-colors hover:border-[var(--color-brand-soft)] focus:border-[var(--color-brand-accent)] focus:outline-none">
                <option value="">All</option>
                {allCategories.map((c) => <option value={c}>{c}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[var(--color-brand-soft)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>

          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <label for="filter-capability" class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-brand-soft)]">Capability</label>
            <div class="relative">
              <select id="filter-capability" class="w-full appearance-none rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-white px-3 py-1.5 pr-7 text-[0.82rem] font-medium text-[var(--color-brand-ink)] transition-colors hover:border-[var(--color-brand-soft)] focus:border-[var(--color-brand-accent)] focus:outline-none">
                <option value="">All</option>
                {allCapabilities.map((c) => <option value={c}>{c}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[var(--color-brand-soft)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>

          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <label for="filter-client-type" class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-brand-soft)]">Client Type</label>
            <div class="relative">
              <select id="filter-client-type" class="w-full appearance-none rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-white px-3 py-1.5 pr-7 text-[0.82rem] font-medium text-[var(--color-brand-ink)] transition-colors hover:border-[var(--color-brand-soft)] focus:border-[var(--color-brand-accent)] focus:outline-none">
                <option value="">All</option>
                {allClientTypes.map((c) => <option value={c}>{c}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-[var(--color-brand-soft)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>
        </div>
      </div>
    )}

    <div id="portfolio-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <div
          id={slugifyProject(project)}
          class="portfolio-card flex flex-col rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-white p-5 transition-shadow hover:shadow-[0_8px_30px_rgba(26,26,26,0.06)] sm:p-6"
          data-categories={JSON.stringify(project.categories)}
          data-capabilities={JSON.stringify(project.capabilities)}
          data-client-type={project.clientType}
        >
          <h3 class="mb-1 text-[1.4rem] font-semibold text-[var(--color-brand-ink)] font-serif">
            {project.title}<a
              href={`#${slugifyProject(project)}`}
              class="portfolio-anchor"
              aria-label={`Link to ${project.title}`}
            >#</a>
          </h3>
          <div class="mb-3 text-[0.82rem] text-[var(--color-brand-soft)]">
            {project.client} &middot; {formatProjectDates(project)}
          </div>
          <p class="mb-4 text-[0.95rem] leading-[1.65] text-[var(--color-brand-muted)]">
            {project.description}
          </p>
          {project.impact.length > 0 && (
            <div class="border-t border-[var(--color-brand-border)] pt-4">
              <div class="mb-1 text-[1.15rem] font-semibold font-serif text-[var(--color-brand-accent)]">
                {project.impact[0].headline}
              </div>
              <p class="text-[0.90rem] leading-[1.55] text-[var(--color-brand-muted)]">
                {project.impact[0].description}
              </p>
            </div>
          )}
          {project.impact.length === 0 && project.clientQuote && (
            <div class="border-t border-[var(--color-brand-border)] pt-4">
              <blockquote class="text-[0.98rem] leading-[1.65] text-[var(--color-brand-muted)] font-serif italic">
                &ldquo;{project.clientQuote.quote}&rdquo;
              </blockquote>
              <div class="mt-2 text-[0.8rem] font-medium text-[var(--color-brand-soft)]">
                — {project.clientQuote.name}
              </div>
            </div>
          )}
          <div class="mt-auto pt-4 flex flex-col gap-1.5">
            <div class="flex flex-wrap gap-1.5">
              {project.categories.map((cat) => (
                <span class="bg-emerald-50 px-2.5 py-0.5 text-[10px] font-semibold uppercase text-[var(--color-brand-ink)]">
                  {cat}
                </span>
              ))}
            </div>
            <div class="flex flex-wrap gap-1.5">
              {project.capabilities.map((cap) => (
                <span class="bg-blue-50 px-2.5 py-0.5 text-[10px] font-medium text-[var(--color-brand-ink)] uppercase">
                  {cap}
                </span>
              ))}
            </div>
          </div>
          {/* {project.role === "Sub" && project.primeContractor && (
            <div class="mt-3 text-[0.8rem] text-[var(--color-brand-soft)]">
              Sub to {project.primeContractor}
            </div>
          )} */}
        </div>
      ))}
    </div>

    <p id="portfolio-empty" class="hidden py-12 text-center text-[1rem] text-[var(--color-brand-soft)]">
      No projects match the selected filters.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('.portfolio-section');
    if (!root) return;

    const catFilter = root.querySelector('#filter-category');
    const capFilter = root.querySelector('#filter-capability');
    const ctFilter = root.querySelector('#filter-client-type');
    const clearBtn = root.querySelector('#filter-clear');
    const cards = root.querySelectorAll('.portfolio-card');
    const empty = root.querySelector('#portfolio-empty');

    if (!catFilter || !capFilter || !ctFilter) return;

    const portfolioAnchor = '#portfolio';
    const filterParams = [
      ['category', catFilter],
      ['capability', capFilter],
      ['client-type', ctFilter],
    ];

    // A card filtered out of the grid is not a valid anchor target.
    function isVisible(card) {
      return card.style.display !== 'none';
    }

    function cardForHash(hash) {
      if (!hash || hash === portfolioAnchor) return null;
      return root.querySelector(`#${CSS.escape(hash.slice(1))}`);
    }

    function syncTargetHighlight() {
      cards.forEach((card) => card.classList.remove('is-targeted'));

      const targetCard = cardForHash(window.location.hash);
      if (targetCard && isVisible(targetCard)) {
        targetCard.classList.add('is-targeted');
      }
    }

    // Applies ?category=&capability=&client-type= to the selects. Values are matched
    // case-insensitively so shared links survive casing tweaks; unknown values fall back to All.
    function readFiltersFromUrl() {
      const params = new URLSearchParams(window.location.search);
      let normalized = false;

      filterParams.forEach(([key, select]) => {
        const value = params.get(key);
        if (value === null) return;

        const match = Array.from(select.options).find(
          (option) => option.value && option.value.toLowerCase() === value.trim().toLowerCase()
        );

        select.value = match ? match.value : '';
        if (!match || match.value !== value) normalized = true;
      });

      return normalized;
    }

    // A card deep link (#project-slug) is kept as long as that card survives the active
    // filters; once it is filtered out, any active filter parks #portfolio on the URL so a
    // shared link still lands on the grid. Must run after applyFilters().
    function resolveHash() {
      const currentHash = window.location.hash;

      if (currentHash && currentHash !== portfolioAnchor) {
        const targetCard = cardForHash(currentHash);
        // An unknown hash belongs to something else on the page — leave it alone.
        if (!targetCard || isVisible(targetCard)) return currentHash;
      }

      const hasFilters = filterParams.some(([, select]) => select.value);
      return hasFilters ? portfolioAnchor : '';
    }

    function writeFiltersToUrl() {
      const params = new URLSearchParams(window.location.search);

      filterParams.forEach(([key, select]) => {
        if (select.value) {
          params.set(key, select.value);
        } else {
          params.delete(key);
        }
      });

      const query = params.toString();
      history.replaceState(
        null,
        '',
        window.location.pathname + (query ? `?${query}` : '') + resolveHash()
      );
    }

    function applyFilters() {
      const cat = catFilter.value;
      const cap = capFilter.value;
      const ct = ctFilter.value;
      let visible = 0;

      cards.forEach((card) => {
        const categories = JSON.parse(card.dataset.categories);
        const capabilities = JSON.parse(card.dataset.capabilities);
        const clientType = card.dataset.clientType;

        const matchCat = !cat || categories.includes(cat);
        const matchCap = !cap || capabilities.includes(cap);
        const matchCt = !ct || clientType === ct;

        if (matchCat && matchCap && matchCt) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      empty.classList.toggle('hidden', visible > 0);
      clearBtn.classList.toggle('hidden', !cat && !cap && !ct);
    }

    function handleFilterChange() {
      applyFilters();
      writeFiltersToUrl();
      syncTargetHighlight();
    }

    catFilter.addEventListener('change', handleFilterChange);
    capFilter.addEventListener('change', handleFilterChange);
    ctFilter.addEventListener('change', handleFilterChange);
    window.addEventListener('hashchange', syncTargetHighlight);

    clearBtn.addEventListener('click', (e) => {
      e.preventDefault();
      catFilter.value = '';
      capFilter.value = '';
      ctFilter.value = '';
      handleFilterChange();
    });

    const needsNormalizing = readFiltersFromUrl();
    applyFilters();
    // On load only add a missing anchor; never strip a #portfolio link someone shared without filters.
    const needsAnchor = resolveHash() && resolveHash() !== window.location.hash;
    if (needsNormalizing || needsAnchor) writeFiltersToUrl();
    syncTargetHighlight();
  })();
</script>

<style>
  .portfolio-section {
    scroll-margin-top: 2rem;
  }

  .portfolio-card {
    scroll-margin-top: 7rem;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
      transform 240ms ease;
  }

  .portfolio-anchor {
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .portfolio-card:hover .portfolio-anchor,
  .portfolio-card.is-targeted .portfolio-anchor,
  .portfolio-anchor:focus-visible {
    opacity: 1;
  }

  .portfolio-card.is-targeted {
    border-color: var(--color-brand-accent);
    box-shadow: 0 0 0 1px rgba(194, 65, 12, 0.15), 0 16px 40px rgba(194, 65, 12, 0.12);
    animation: portfolio-target-pulse 700ms ease-out;
  }
  .portfolio-card.is-targeted .portfolio-anchor {
    color: var(--color-brand-accent);
  }

  @keyframes portfolio-target-pulse {
    0% {
      transform: translateY(10px);
      box-shadow: 0 0 0 0 rgba(194, 65, 12, 0);
    }

    100% {
      transform: translateY(0);
      box-shadow: 0 0 0 1px rgba(194, 65, 12, 0.15), 0 16px 40px rgba(194, 65, 12, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-card {
      transition: border-color 0ms ease, box-shadow 0ms ease, transform 0ms ease;
    }

    .portfolio-card.is-targeted {
      animation: none;
    }

    .portfolio-anchor {
      color: var(--color-brand-soft);
      margin-left: 6px;
      transition: opacity 0ms ease;
    }
  }
</style>
