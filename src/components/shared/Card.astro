---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'article';
};

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    'flex flex-col rounded-[var(--radius-card)] border border-[var(--color-brand-border)] bg-white p-5 transition-shadow hover:shadow-[0_8px_30px_rgba(26,26,26,0.06)] sm:p-6',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
