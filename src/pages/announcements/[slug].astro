---
import { render } from "astro:content";
import Eyebrow from "../../components/shared/Eyebrow.astro";
import Layout from "../../layouts/Layout.astro";
import {
  formatPostDate,
  getLocalAnnouncements,
} from "../../lib/blog";

export async function getStaticPaths() {
  return (await getLocalAnnouncements()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <section class="surface-subtle pt-6 pb-12 sm:pt-12 sm:pb-18 border-t border-[var(--color-brand-border)]">
    <div class="page-shell">
      <header class="layout-grid border-b border-[var(--color-brand-border)] pb-6">
        <div class="col-span-12">
          <h1 class="display-2">{post.data.title}</h1>
        </div>
        <div class="col-span-12 lg:col-span-8">
          <div class="flex flex-wrap gap-x-3 text-[0.95rem] text-[var(--color-brand-soft)]">
            <time datetime={post.data.publishDate.toISOString()}>{formatPostDate(post.data.publishDate)}</time>
          </div>
        </div>
      </header>

      <div class="layout-grid pt-10">
        <div class="blog-prose col-span-12 lg:col-span-8">
          <Content />
        </div>
      </div>

      <footer class="layout-grid mt-14 border-t border-[var(--color-brand-border)] pt-8">
        <div class="col-span-12 lg:col-span-8">
          <a class="inline-flex font-medium text-[var(--color-brand-accent)] underline underline-offset-4" href="/newsroom/">
            &lt; Back to all announcements
          </a>
        </div>
      </footer>
    </div>
  </section>
</Layout>
