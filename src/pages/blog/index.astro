---
import Layout from "../../layouts/Layout.astro";
import BlogListing from "../../components/page-sections/blog/BlogListing";
import { getCollection } from "astro:content";
import {
  formatPostDate,
  getBlogPostsWithAuthors,
  postsForBuild,
} from "../../lib/blog";

const posts = postsForBuild(await getBlogPostsWithAuthors());
const authors = (await getCollection("authors"))
  .map((author) => ({ id: author.id, name: author.data.display_name }))
  .sort((a, b) => a.name.localeCompare(b.name));
const tags = [...new Set(posts.flatMap(({ post }) => post.data.tags))].sort(
  (a, b) => a.localeCompare(b),
);
const listingPosts = posts.map(({ post, author }) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  dateLabel: formatPostDate(post.data.pubDate),
  tags: post.data.tags,
  author: {
    id: author.id,
    name: author.data.display_name,
    githubUrl: `https://github.com/${encodeURIComponent(author.id)}`,
  },
}));
---

<Layout
  title="Blog"
  description="Ideas and field notes from Focus about public digital services, delivery, and building systems that endure."
>
  <section class="page-shell pb-18 pt-6 sm:pb-24">
    <div class="layout-grid pb-2 sm:pb-3">
      <div class="col-span-12 lg:col-span-9">
        <h1 class="meta-label text-[var(--color-brand-accent)]">Blog</h1>
      </div>
    </div>

    <BlogListing client:load posts={listingPosts} tags={tags} authors={authors} />

    <a class="mt-8 inline-flex text-[0.92rem] font-medium text-[var(--color-brand-accent)] underline underline-offset-4" href="/rss.xml">
      Subscribe via RSS
    </a>
  </section>
</Layout>
